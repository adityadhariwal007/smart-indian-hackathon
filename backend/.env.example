# ==============================================================================
# HealthFlow AI Symptom Assessment Backend Environment Configuration
# ==============================================================================

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173

# Infermedica Conversational Triage API Credentials
# (Obtain from developer.infermedica.com - Keep strictly on backend, never frontend!)
INFERMEDICA_CLIENT_ID=your_infermedica_client_id_here
INFERMEDICA_CLIENT_SECRET=your_infermedica_client_secret_here
INFERMEDICA_INSTANCE_ID=your_infermedica_instance_id_here
INFERMEDICA_SCOPE=conversational_triage:write

# Optional Database Connection (Postgres/Supabase or local SQLite)
DATABASE_URL=sqlite:///./healthflow_ai.db

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
